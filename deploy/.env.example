# This file stays on the server as deploy/.env. Do not commit the real file.
APP_NAME="CEA Hardware Eshop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://YOUR_PUBLIC_IP
FRONTEND_URL=http://YOUR_PUBLIC_IP

DB_CONNECTION=mysql
DB_DATABASE=cea_eshop
DB_USERNAME=cea_app
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
LOG_CHANNEL=stderr
LOG_LEVEL=warning

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Use 80 locally and on the first EC2 deployment. Change APP_URL and this
# value only when a domain and TLS are configured.
HTTP_PORT=80
