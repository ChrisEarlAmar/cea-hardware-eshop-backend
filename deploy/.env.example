# This file stays on the server as deploy/.env. Do not commit the real file.
APP_NAME="CEA Hardware Eshop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://YOUR_PUBLIC_IP
FRONTEND_URL=http://YOUR_PUBLIC_IP

DB_CONNECTION=mysql
DB_DATABASE=cea_eshop
DB_USERNAME=cea_app
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Seed the portfolio catalog and demo accounts once on a fresh database.
# The migration service records completion in the persistent storage volume,
# so later deployments only run migrations. Set false for a blank database.
SEED_DEMO_DATA=true
# Required only when SEED_DEMO_DATA=true. Use distinct, long passwords on AWS.
DEMO_USER_PASSWORD=replace-with-a-long-demo-user-password
DEMO_STAFF_PASSWORD=replace-with-a-different-long-demo-staff-password

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Use 80 locally and on the first EC2 deployment. Change APP_URL and this
# value only when a domain and TLS are configured.
HTTP_PORT=80
